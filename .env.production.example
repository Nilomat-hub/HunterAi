# Production .env for the single-VPS Docker stack (docker-compose.prod.yml).
# Copy to `.env` on the server and fill in. NEVER commit the real .env.

# --- Domain & app URL ---
# Your real domain (DNS A-record must point to the VPS).
DOMAIN=hunter.example.com
NEXTAUTH_URL=https://hunter.example.com
APP_URL=https://hunter.example.com

# --- Database (compose builds DATABASE_URL from these for the app) ---
POSTGRES_USER=apartment_hunter
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=apartment_hunter

# --- Secrets (generate strong random values) ---
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME
# openssl rand -base64 32
CRON_SECRET=CHANGE_ME
# Base64-encoded 32-byte key: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME

# --- Initial login user (seeded once; use a real password!) ---
INITIAL_USER_EMAIL=you@example.com
INITIAL_USER_PASSWORD=CHANGE_ME_before_first_seed

# --- OpenAI (optional; without it a deterministic letter template is used) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram (optional; without it notifications are only stored in the DB) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scheduler ---
# How often the listing scan runs, in seconds (default 900 = 15 min).
SCHEDULER_INTERVAL_SECONDS=900
